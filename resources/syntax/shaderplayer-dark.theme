        "Documentation": {
            "_comment": "The leading ISF block. It stays at caption contrast (9.6:1 on the band below) and recedes by sitting on its own violet-tinted slab instead, because it is the authoritative parameter declaration and dimming real content below the legibility floor is not an option.",
            "text-color": "#B8BCC4",
            "background-color": "#171225",
            "selected-text-color": "#06181B",
            "italic": true
        },
        "Annotation": {
