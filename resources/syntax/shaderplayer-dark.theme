    "editor-colors": {
        "_comment": "EditorPanel reads CurrentLine, BracketMatching, IconBorder, Separator, LineNumbers, CurrentLineNumber and MarkError back out of the loaded theme. They are the editor chrome, and they live here so no colour is spelled out in C++.",
        "BackgroundColor": "#0B0B0B",
        "TextSelection": "#3DE0F0",
        "CurrentLine": "#0AFFFFFF",
        "BracketMatching": "#603DE0F0",
        "IconBorder": "#40000000",
        "Separator": "#40A97CFF",
        "LineNumbers": "#B8BCC4",
        "CurrentLineNumber": "#A97CFF",
        "CodeFolding": "#264A50",
        "IndentationLine": "#1AFFFFFF",
        "WordWrapMarker": "#1AFFFFFF",
        "TabMarker": "#26FFFFFF",
        "SpellChecking": "#FF5A52",
        "SearchHighlight": "#60A3F04A",
        "ReplaceHighlight": "#60FFB63D",
        "ModifiedLines": "#FFB63D",
        "SavedLines": "#A3F04A",
        "MarkBookmark": "#405AA8FF",
        "MarkBreakpointActive": "#40FF5A52",
        "MarkBreakpointReached": "#40FFB63D",
        "MarkBreakpointDisabled": "#40FF5FD2",
        "MarkExecution": "#40B8BCC4",
        "MarkWarning": "#40FFB63D",
        "MarkError": "#FF5A52",
        "TemplateBackground": "#171225",
        "TemplatePlaceholder": "#264A50",
        "TemplateFocusedPlaceholder": "#2F6A73",
        "TemplateReadOnlyPlaceholder": "#2A1413"
    }
}
