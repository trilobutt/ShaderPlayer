# Build directories
build/
out/
Release/
Debug/
RelWithDebInfo/
MinSizeRel/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestFile.cmake
_deps/

# Visual Studio
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters

# Binaries
*.exe
*.dll
*.pdb
*.ilk
*.obj

# FFmpeg: commit headers (include/) and import libs (lib/), ignore runtime DLLs
# Note: *.dll above already handles third_party/ffmpeg/bin/*.dll

# IDE
# .vscode/settings.json is tracked: it pins CMake Tools to CMakePresets.json, without which
# the extension configures build/ as Debug with no Qt hint. The negation needs the /*
# form, since git does not descend into an excluded directory to find exceptions.
.vscode/*
!.vscode/settings.json
.idea/

# OS
Thumbs.db
.DS_Store

# User config (if it contains local paths)
config_local.json

# Git worktrees
.worktrees/

# Python bytecode (tools/validate_shaders.py imported by external pipelines)
__pycache__/
*.pyc
